{
  "name": "@xapxap/db",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schemas/users": "./src/users/schema/index.ts",
    "./schemas/wallets": "./src/wallets/schema/index.ts",
    "./schemas/content": "./src/content/schema/index.ts",
    "./schemas/fame": "./src/fame/schema/index.ts",
    "./schemas/streams": "./src/streams/schema/index.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/seed/index.ts",
    "db:seed:fresh": "bun run db:migrate && bun run src/seed/index.ts -f"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "mime-types": "^3.0.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "drizzle-kit": "^0.20.0"
  }
}
