{
  "name": "xapxap-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "biome check --write --unsafe",
    "typecheck": "cd apps/mobile && bun run typecheck",
    "db:generate": "cd packages/db && bun run db:generate",
    "db:push": "cd packages/db && bun run db:push",
    "db:migrate": "cd packages/db && bun run db:migrate",
    "db:studio": "cd packages/db && bun run db:studio",
    "db:seed": "cd packages/db && bun run db:seed",
    "db:seed:fresh": "cd packages/db && bun run db:seed:fresh",
    "start:mobile": "cd apps/mobile && bun run start",
    "start:supabase": "cd apps/supabase && bunx supabase start"
  },
  "overrides": {
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-manifests": "~57.0.1",
    "expo-updates-interface": "~57.0.1",
    "expo-json-utils": "~57.0.1"
  }
}
